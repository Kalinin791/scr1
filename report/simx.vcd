     $var wire 32 Q. SCR1_TIMER_CONTROL_CLKSRC_OFFSET [31:0] $end
     $var wire 32 _. SCR1_TIMER_DIVIDER_WIDTH [31:0] $end
     $var wire 64 x" mtime_reg [63:0] $end
     $var wire 64 X- mtime_new [63:0] $end
     $var wire 64 r$ mtimecmp_reg [63:0] $end
     $var wire 64 F+ mtimecmp_new [63:0] $end
     $var wire 1 t$ timer_en $end
     $var wire 1 Z- timer_clksrc_rtc $end
     $var wire 10 u$ timer_div [9:0] $end
